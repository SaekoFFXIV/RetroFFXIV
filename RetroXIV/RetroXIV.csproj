<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.8.2</Version>
    <AssemblyName>RetroXIV</AssemblyName>
    <RootNamespace>RetroXIV</RootNamespace>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="2.3.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="2.3.0" />
    <PackageReference Include="Vortice.DXGI" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="bsnes_libretro.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="resources\GameIndex.yaml" CopyToOutputDirectory="PreserveNewest" Link="resources\GameIndex.yaml" />
    <None Include="snes_h264.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="openh264-2.6.0-win64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="snes_opus.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="opus.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('cores')">
    <None Include="cores\*_libretro.dll" CopyToOutputDirectory="PreserveNewest" Link="cores\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EmulatorStream\EmulatorStream.csproj" />
  </ItemGroup>
</Project>
