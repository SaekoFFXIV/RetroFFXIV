<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless boot test for libretro cores against the real RetroCore
       frontend code (no Dalamud, no rendering). Not part of the solution:
       dotnet run -project tools/core-smoke - -core <dll> -system <dir> -save <dir> -rom <file> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>CoreSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SnesEmulator\Emulation\Libretro.cs" />
    <Compile Include="..\..\SnesEmulator\Emulation\RetroCore.cs" />
    <Compile Include="..\..\EmulatorStream\IEmulatorBackend.cs" />
  </ItemGroup>
</Project>
